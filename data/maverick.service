[Unit]
Description=Maverick: contador de YouTube
Documentation=https://github.com/luiz-nast/maverick
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=GDK_BACKEND=x11
ExecStart=/usr/bin/maverick daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
